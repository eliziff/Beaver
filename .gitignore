# Playwright artifacts and the bootstrapped e2e session (contains auth tokens)
.tmp-ui/
.tmp-qa/
.qa/
test-results/
playwright-report/
e2e/.auth/

# Local Supabase scaffold (supabase init output) — the local stack is a test
# harness only; CI scaffolds its own fresh copy on every run
backend/supabase/

# Vendored LAB corpus: local venv and caches stay untracked
benchmarks/harvey-labs/.venv/
benchmarks/harvey-labs/**/__pycache__/

# Harvey LAB launchpad generated artifacts — regenerable from the corpus via
# benchmarks/harvey-labs/tools/generate_launchpad.py (the 86 MB materials JSON
# embeds already-tracked task document text; history does not need a copy)
benchmarks/harvey-labs/launchpad.html
benchmarks/harvey-labs/launchpad_materials.json
benchmarks/harvey-labs/results-quarantine/

# Local Harvey taxonomy analysis outputs; regenerate from the tracked helpers.
benchmarks/harvey-labs/_sweep_all.json
benchmarks/harvey-labs/_taxonomy_*.json
benchmarks/harvey-labs/_taxonomy_*.txt
benchmarks/harvey-labs/_titles.txt

# Raw local citation-split diagnostic output; durable findings live in RESULTS.md.
original_details.jsonl

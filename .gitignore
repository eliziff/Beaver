# Raw experiment output stays local. Reviewed findings belong in RESULTS.md.
experiments/**/results/
experiments/**/receipts/
backend/experiments/**/results/
backend/experiments/**/receipts/

# User-supplied benchmark documents and derived local manifests can contain
# privileged or otherwise non-redistributable material.  Keep the harness in
# git, but never commit the private corpus.
benchmarks/docx_corpus/private_sources/
benchmarks/docx_corpus/private_results/
benchmarks/docx_corpus/private_manifest.json
benchmarks/docx_corpus/private_manifest.jsonl
benchmarks/prompt_live/
benchmarks/deeplink_gate/
benchmarks/sourcedoc/bench-pinpoint-*.json
benchmarks/sourcedoc/bench-structure-*.json
benchmarks/traces/
benchmarks/beaver_can/private_results/
benchmarks/legalbench_rag/data/
benchmarks/legalbench_rag/results/
benchmarks/legalbench/data/
benchmarks/legalbench/results/
backend/src/lib/chat/*.old.harness.ts

# Playwright artifacts and the bootstrapped e2e session (contains auth tokens)
.tmp-ui/
.tmp-qa/
.qa/
test-results/
playwright-report/
e2e/.auth/
mike-workflows/

# Local Supabase scaffold (supabase init output) — the local stack is a test
# harness only; CI scaffolds its own fresh copy on every run
backend/supabase/

# Vendored LAB corpus: local venv and caches stay untracked
benchmarks/harvey-labs/.venv/
benchmarks/harvey-labs/**/__pycache__/

# Harvey LAB launchpad generated artifacts — regenerable from the corpus via
# benchmarks/harvey-labs/tools/generate_launchpad.py (the 86 MB materials JSON
# embeds already-tracked task document text; history does not need a copy)
benchmarks/harvey-labs/launchpad.html
benchmarks/harvey-labs/launchpad_materials.json

{
  "name": "mike-backend",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "import:a2aj-bulk": "python scripts/import_a2aj_bulk.py",
    "fetch:courtlistener-bulk": "python scripts/fetch_courtlistener_bulk.py",
    "import:courtlistener-bulk": "python scripts/import_courtlistener_bulk.py",
    "build:journals-fts": "python scripts/build_journal_search_index.py",

    "dictionary-en-ca": "^3.0.0",
    "docx": "^9.7.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.1",
    "fast-diff": "^1.3.0",
    "fast-xml-parser": "^5.7.1",
    "helmet": "^8.1.0",

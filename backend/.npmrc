# Supply-chain hardening: nothing in this dependency tree declares a
# preinstall/install/postinstall script (verified via `npm query` 2026-07-27),
# so refuse to execute any. A compromised package update cannot run code at
# install time; if a future dependency genuinely needs a build script, add it
# deliberately via `npm rebuild <pkg>` rather than removing this line.
ignore-scripts=true

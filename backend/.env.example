PORT=3001
FRONTEND_URL=http://localhost:3000
AUTH_MODE=anonymous
ANONYMOUS_USER_ID=00000000-0000-0000-0000-000000000001

# HMAC key used to sign /download/:token URLs. Required at startup.
# Generate with: openssl rand -hex 32
# Use a dedicated secret distinct from SUPABASE_SECRET_KEY.
DOWNLOAD_SIGNING_SECRET=replace-with-a-random-32-byte-hex-string
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-key

R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=mike

GEMINI_API_KEY=your-gemini-key
ANTHROPIC_API_KEY=your-anthropic-key
OPENAI_API_KEY=your-openai-key
DEEPSEEK_API_KEY=your-deepseek-key
# Optional compatibility fallback for an existing local DeepSeek key.
DEEPSEEK_OCR_KEY=
OPENROUTER_API_KEY=your-openrouter-key
USER_API_KEYS_ENCRYPTION_SECRET=your-long-random-secret
OLLAMA_BASE_URL=http://your-desktop:11434
OLLAMA_HOST_HEADER=
OLLAMA_NUM_CTX=32768
OLLAMA_MODELS=qwen3.5:2b,qwen3.5:9b
OLLAMA_THINKING_MODELS=qwen3.5:2b,qwen3.5:9b

# Optional MCP OAuth defaults. Static client credentials are used only when
# every MCP/issuer/authorization/token origin is listed exactly here.
MCP_OAUTH_CONFIDENTIAL_ORIGINS=
MCP_OAUTH_CLIENT_ID=
MCP_OAUTH_CLIENT_SECRET=
MCP_OAUTH_DEFAULT_SCOPE=

# Optional: enables higher-rate CourtListener case law/citation lookup tools.
COURTLISTENER_API_TOKEN=your-courtlistener-token
GOVINFO_API_KEY=

# Shared legal databases/caches. Defaults to the operating system's local
# AppData/OpenLegalProducts/LegalData directory.
OPEN_LEGAL_DATA_HOME=

# Anonymous Library storage defaults to OPEN_LEGAL_DATA_HOME/apps/mike/library.
# Set this only to override Beaver's Library directory.
MIKE_LOCAL_DATA_DIR=

# Optional explicit database overrides.
MIKE_A2AJ_BULK_DB=
MIKE_COURTLISTENER_BULK_DB=
MIKE_PUBLIC_ENDPOINT_DB=
MIKE_PUBLIC_ENDPOINT_FTS_DB=

# Optional stochastic legal-grounding checker. Deterministic citation placement
# from exact A2AJ receipts is automatic. Exact checker values:
# compose_check, evidence_first, holistic_check, or tiered_check.
MIKE_LEGAL_EVIDENCE_EXPERIMENT=

# Optional standalone Table of Authorities host overrides.
TOA_MAKER_DIR=
TOA_PYTHON=
TOA_WEB_PORT=8765

# Optional legacy Supabase/R2 bulk cache.
COURTLISTENER_BULK_DATA_ENABLED=false

AUTH_MODE=local
LOCAL_USER_ID=00000000-0000-0000-0000-000000000001

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-service-role-key
# Configure SAML providers in GoTrue before enabling progressive SSO sign-in.
SSO_ENABLED=false
# Optional comma-separated domain allowlist; empty allows all configured providers.
SSO_ALLOWED_DOMAINS=
# Persistent backend connection (direct or Supabase session-pooler URL).
DATABASE_URL=postgresql://beaver_app:password@db.example.com:5432/postgres
DATABASE_POOL_SIZE=10
PUBLIC_ORIGIN=https://beaver.example.com

# Set only when every public request reaches Beaver through exactly this many
# trusted reverse-proxy hops. Unset is the secure direct-connection default.
TRUST_PROXY_HOPS=

# Required in cloud mode. Use a private AWS S3, R2, Supabase Storage S3,
# or MinIO bucket. Path style is normally needed by Supabase S3 and MinIO.
S3_ENDPOINT=https://your-s3-endpoint
S3_REGION=your-region
S3_BUCKET=your-private-bucket
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
S3_FORCE_PATH_STYLE=false

GEMINI_API_KEY=your-gemini-key
ANTHROPIC_API_KEY=your-anthropic-key
OPENAI_API_KEY=your-openai-key
# Configuring this key authorizes TypeSafe document processing for suitable review cells.
# Without a key the existing review path is unchanged. See src/lib/tabular/README.md.
TYPESAFE_API_KEY=
TYPESAFE_JEV_MODEL=jev-1.13.0
# auto | off. Auto answers suitable cells and falls back to the normal review model.
BEAVER_JEV_TABULAR_MODE=auto
BEAVER_JEV_EVIDENCE_MIN=0.5
# Total deadline for the Jev answer/evidence phase, not a per-retry budget.
BEAVER_JEV_TIMEOUT_MS=4000
DEEPSEEK_API_KEY=your-deepseek-key
OPENROUTER_API_KEY=your-openrouter-key
OPENCODE_GO_API_KEY=your-opencode-go-key
META_API_KEY=your-meta-model-api-key
# Optional: set to classic to use the older grounded quotation policy.
BEAVER_GROUNDED_QUOTATION_POLICY=
# Generate separate values with a cryptographic password generator (32+ characters).
USER_API_KEYS_ENCRYPTION_SECRET=
# Defaults off in account-free local mode and on in cloud mode.
MCP_CONNECTORS_ENABLED=
MCP_CONNECTORS_ENCRYPTION_SECRET=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TRUSTED_HTTP_ORIGINS=
OLLAMA_HOST_HEADER=
OLLAMA_NUM_CTX=32768

# Optional MCP OAuth defaults. Static client credentials are used only when
# every MCP/issuer/authorization/token origin is listed exactly here.
MCP_OAUTH_CONFIDENTIAL_ORIGINS=
MCP_OAUTH_CLIENT_ID=
MCP_OAUTH_CLIENT_SECRET=
MCP_OAUTH_DEFAULT_SCOPE=
# Provider-specific clients can coexist with a generic MCP OAuth client.
# List every discovered resource/authorization/token/registration origin; secrets
# are withheld if any endpoint is outside the selected client's allowlist.
SLACK_MCP_OAUTH_CLIENT_ID=
SLACK_MCP_OAUTH_CLIENT_SECRET=
SLACK_MCP_OAUTH_SCOPE=
SLACK_MCP_OAUTH_CONFIDENTIAL_ORIGINS=https://mcp.slack.com,https://slack.com
GOOGLE_MCP_OAUTH_CLIENT_ID=
GOOGLE_MCP_OAUTH_CLIENT_SECRET=
GOOGLE_MCP_OAUTH_SCOPE=
GOOGLE_MCP_OAUTH_CONFIDENTIAL_ORIGINS=https://drivemcp.googleapis.com,https://accounts.google.com,https://oauth2.googleapis.com

# Optional: enables higher-rate CourtListener case law/citation lookup tools.
COURTLISTENER_API_TOKEN=your-courtlistener-token
GOVINFO_API_KEY=

# Shared legal databases/caches. Defaults to the operating system's local
# AppData/OpenLegalProducts/LegalData directory.
OPEN_LEGAL_DATA_HOME=

# Account-free Library storage defaults to OPEN_LEGAL_DATA_HOME/apps/mike/library.
# Set this only to override Beaver's Library directory.
MIKE_LOCAL_DATA_DIR=

# Legal PDF Parser. Beaver uses the native structure addon directly. The local
# release addon and Kraken runtime paths are discovered automatically; these
# overrides are for packaged or externally installed runtimes.
LEGALPDF_ENGINE_ROOT=
LEGAL_STRUCTURE_NATIVE=
# none, kraken-lite, or tesseract
MIKE_PDF_OCR_PROVIDER=kraken-lite
LEGALPDF_KRAKEN_LAYOUT=tesseract
LEGALPDF_KRAKEN_MODEL=
LEGALPDF_KRAKEN_CODEC=
LEGALPDF_ONNX_RUNTIME=
LEGALPDF_KRAKEN_TESSERACT_LIBRARY=
LEGALPDF_KRAKEN_BACKEND=cpu
LEGALPDF_KRAKEN_TIER=quality

# Full stock-BLLA quality route (used when LEGALPDF_KRAKEN_LAYOUT=blla).
LEGALPDF_KRAKEN_RUNTIME_WHEEL=
LEGALPDF_KRAKEN_BLLA_PACK=
LEGALPDF_KRAKEN_RECOGNIZER_PACK=
LEGALPDF_KRAKEN_PYTHON=

# PDF layout: unset auto-selects a bundled local pack, "none" disables layout,
# "local" requires the paths below, and "mllm" uses the existing vision-capable
# provider dispatch. The MLLM default is the inexpensive gpt-5.6-luna; set any
# other Beaver vision model explicitly when higher cost is acceptable.
MIKE_PDF_LAYOUT_PROVIDER=
MIKE_PDF_LAYOUT_MODEL=gpt-5.6-luna
MIKE_PDF_LAYOUT_CONCURRENCY=4
MIKE_PDF_LAYOUT_DPI=120
LEGALPDF_PPDOC_MODEL_PACK=
LEGALPDF_PPDOC_RUNTIME=
LEGALPDF_PPDOC_BACKEND=openvino
LEGALPDF_PPDOC_THREADS=4
LEGALPDF_PPDOC_DEVICE=

# Optional explicit database overrides.
# Required to save personal API keys, in local or cloud mode. Generate a unique
# random secret (at least 32 characters); retain it with the encrypted database.
USER_API_KEYS_ENCRYPTION_SECRET=
# Optional Ed25519 export signing seed: 32 random bytes encoded as 64 hex digits.
# Keep separate from encryption keys. An invalid configured key fails exports.
MANIFEST_SIGNING_KEY=
# Optional OpenAI-compatible endpoints; IDs appear as configured:<id>.
# MIKE_MODEL_CONFIG_JSON={"models":[{"id":"local-qwen","provider":"openai-compatible","location":"local","baseUrl":"http://127.0.0.1:8000/v1","apiModel":"qwen3-32b"}]}
MIKE_A2AJ_BULK_DB=
MIKE_COURTLISTENER_BULK_DB=
MIKE_PUBLIC_ENDPOINT_DB=
MIKE_PUBLIC_ENDPOINT_FTS_DB=

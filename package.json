{
    "name": "mike",
    "private": true,
    "scripts": {
        "measure:source": "node scripts/measure-source.mjs",
        "test:source-budget": "node scripts/measure-source.mjs --self-test",
        "check:source-budget": "node scripts/measure-source.mjs --check scripts/legal-structure-guardrails.json",
        "check:grammar": "node packages/legal-grammar-tables/check.mjs",
        "check:source-boundaries": "node scripts/check-source-boundaries.mjs",
        "audit:court-output-sources": "node scripts/audit-court-output-sources.mjs",
        "test:court-output-audit": "node --test scripts/audit-court-output-sources.test.mjs",
        "test:authorities-package": "node --test scripts/authorities-package/bundle.test.mjs",
        "test:authorities:highlights": "node scripts/test-authorities-highlights.mjs",
        "test:authorities:browser": "node scripts/test-authorities-standalone.mjs",
        "dev:authorities": "node scripts/authorities-dev.mjs",
        "package:authorities": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-authorities.ps1",
        "test:court-records:browser": "npm run build --prefix frontend && python scripts/test-court-records-browser.py",
        "test:experiments": "npm run test:experiments --prefix backend",

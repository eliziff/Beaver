{
    "name": "beaver",
    "private": true,
    "scripts": {
        "native:build": "node scripts/native-build.mjs",
        "native:build:release": "node scripts/native-build.mjs --release",
        "check:grammar": "node packages/legal-grammar-tables/check.mjs",
        "audit:court-output-sources": "node scripts/audit-court-output-sources.mjs",
        "test:court-output-audit": "node --test scripts/audit-court-output-sources.test.mjs",
        "test:authorities:highlights": "node scripts/test-authorities-highlights.mjs",
        "dev:authorities": "node AuthoritiesHelper/modern/authorities-dev.mjs",
        "package:authorities": "powershell -NoProfile -ExecutionPolicy Bypass -File AuthoritiesHelper/modern/package-authorities.ps1",
        "build:authorities-html": "node --import ./scripts/background-work.mjs AuthoritiesHelper/modern/html/build.mjs",
        "build:alr-html": "node --import ./scripts/background-work.mjs AuthoritiesHelper/modern/alr/build.mjs",
        "build:alr": "node --import ./scripts/background-work.mjs AuthoritiesHelper/modern/alr/build.mjs --release --all",
        "build:authorities-engine": "node --import ./scripts/background-work.mjs AuthoritiesHelper/modern/html/build-engine.mjs",
        "test:authorities-stress": "node scripts/test-authorities-stress.mjs",
        "test:court-records:browser": "playwright test --config=playwright.local-smoke.config.ts court-records-browser.spec.ts",
        "test:experiments": "npm run test:experiments --prefix backend",
        "test:e2e": "playwright test",
        "test:e2e:cloud": "bash scripts/e2e-local-stack.sh",
        "test:e2e:headed": "playwright test --headed",
        "test:e2e:ui": "playwright test --ui",
        "build:shared": "node --import ./scripts/background-work.mjs scripts/build-shared.mjs",
        "test:browser": "playwright test --config=playwright.local-smoke.config.ts"
    },
    "devDependencies": {
        "@playwright/test": "^1.61.1",
        "@types/node": "^22.14.1",
        "typescript": "^5.8.3"
    },
    "engines": {
        "node": ">=22.13.0"
    },
    "license": "AGPL-3.0-only",
    "dependencies": {
        "pdf-lib": "^1.17.1",
        "zod": "^3.25.76",
        "mike": "*"
    },
    "workspaces": [
        "backend",
        "frontend",
        "shared"
    ]
}

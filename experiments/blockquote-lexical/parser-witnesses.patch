+/// Each run of quoted lines as an unlabelled section, so the paragraphs and numbers a document
+/// quotes sit inside the quotation and a reader can find it; like a heading's section, it is
+/// never a pinpoint's target.
+pub(super) fn quotation_sections(
+    index: &super::graph::PdfTextIndex,
+    pages: &[Page],
+    quoted: &HashSet<String>,
+) -> Vec<legal_structure_model::StructureNode> {
+    use legal_structure_model::{Derivation, NodeKind, ScalarRange, StructureNode};
+    let page_of = pages
+        .iter()
+        .flat_map(|page| page.lines.iter().map(move |line| (line.id.as_str(), page.index)))
+        .collect::<HashMap<_, _>>();
+    // Quoted lines in reading order, parted where an unquoted line of the body comes between.
+    let mut runs: Vec<Vec<String>> = Vec::new();
+    let mut open = false;
+    for line in index.line_ids(ScalarRange {
+        start: 0,
+        end: index.text().chars().count(),
+    }) {
+        if quoted.contains(&line) {
+            if !open {
+                runs.push(Vec::new());
+            }
+            runs.last_mut().expect("an open run").push(line);
+            open = true;
+        } else if page_of.contains_key(line.as_str()) {
+            open = false;
+        }
+    }
+    runs.into_iter()
+        .enumerate()
+        .filter_map(|(position, line_ids)| {
+            let ranges = line_ids
+                .iter()
+                .filter_map(|id| index.line(id).map(|line| line.range))
+                .collect::<Vec<_>>();
+            let range = ScalarRange {
+                start: ranges.iter().map(|range| range.start).min()?,
+                end: ranges.iter().map(|range| range.end).max()?,
+            };
+            let mut node = StructureNode::new(
+                format!("quotation-{:06}", position + 1),
+                NodeKind::Section,
+                range,
+                "legalpdf.pdf-structure.v2",
+                Derivation::Heuristic,
+                None,
+            );
+            node.grammar = Some("quotation".to_owned());
+            let mut seen = HashSet::new();
+            node.page_indexes = line_ids
+                .iter()
+                .filter_map(|id| page_of.get(id.as_str()).copied())
+                .filter(|page| seen.insert(*page))
+                .collect();
+            node.line_ids = line_ids;
+            Some(node)
+        })
+        .collect()
+}
diff --git a/legal-pdf-structure/src/structure/quote_lexicon.rs b/legal-pdf-structure/src/structure/quote_lexicon.rs
new file mode 100644
index 0000000..5455209
--- /dev/null
+++ b/legal-pdf-structure/src/structure/quote_lexicon.rs
@@ -0,0 +1,150 @@
+//! How much a passage reads like the words of another text, from its words alone: a logistic
+//! score over the words that open and close it, the words of the line introducing it and the
+//! word that follows it, its vocabulary, and the marks of an altered quotation (an ellipsis,
+//! "[emphasis added]", a bracketed word). Learned from block quotations and running text in
+//! law journals (the Open Access Journals Database's packages) and judgments (A2AJ, whose
+//! unnumbered paragraphs between numbered ones are what a judgment quotes); see
+//! `experiments/blockquote-lexical`. It weighs a passage only; where a quotation starts and
+//! ends is the layout's to say.
+
+use regex::Regex;
+use std::collections::{HashMap, HashSet};
+use std::sync::OnceLock;
+
+const TABLE: &str = include_str!("quote_lexicon.tsv");
+const BITS: u32 = 20;
+
+struct Lexicon {
+    bias: f64,
+    weights: HashMap<u32, f64>,
+}
+
+fn lexicon() -> &'static Lexicon {
+    static LEXICON: OnceLock<Lexicon> = OnceLock::new();
+    LEXICON.get_or_init(|| {
+        let mut bias = 0.0;
+        let mut weights = HashMap::new();
+        for line in TABLE.lines() {
+            let Some((key, value)) = line.split_once('\t') else {
+                continue;
+            };
+            let Ok(value) = value.parse::<f64>() else {
+                continue;
+            };
+            match key {
+                "bias" => bias = value,
+                bucket => {
+                    if let Ok(bucket) = bucket.parse::<u32>() {
+                        weights.insert(bucket, value);
+                    }
+                }
+            }
+        }
+        Lexicon { bias, weights }
+    })
+}
+
+fn fnv1a(text: &str) -> u32 {
+    text.bytes().fold(0x811C_9DC5, |hash: u32, byte| {
+        (hash ^ u32::from(byte)).wrapping_mul(0x0100_0193)
+    })
+}
+
+fn tokens(text: &str) -> Vec<String> {
+    static WORD: OnceLock<Regex> = OnceLock::new();
+    WORD.get_or_init(|| {
+        Regex::new(r"[A-Za-z\u{c0}-\u{24f}]+(?:'[a-z]+)?|\d+|[^\sA-Za-z\d]").expect("word regex")
+    })
+    .find_iter(text)
+    .map(|word| word.as_str().to_lowercase())
+    .collect()
+}
+
+fn shape(character: Option<char>) -> &'static str {
+    let Some(character) = character else {
+        return "none";
+    };
+    if character.is_lowercase() {
+        "lower"
+    } else if character.is_uppercase() {
+        "upper"
+    } else if character.is_numeric() {
+        "digit"
+    } else {
+        match character {
+            '"' | '\u{201c}' | '\u{2018}' | '\'' | '\u{201d}' | '\u{2019}' => "quote",
+            '.' => "stop",
+            ':' => "colon",
+            ';' => "semi",
+            ',' => "comma",
+            '(' | ')' => "paren",
+            '[' | ']' => "bracket",
+            '\u{2026}' => "ellipsis",
+            '-' | '\u{2013}' | '\u{2014}' => "dash",
+            _ => "other",
+        }
+    }
+}
+
+fn features(text: &str, before: &str, after: &str) -> HashSet<String> {
+    static ALTERATION: OnceLock<Regex> = OnceLock::new();
+    static NOTE: OnceLock<Regex> = OnceLock::new();
+    let (text, before, after) = (text.trim(), before.trim(), after.trim());
+    let (words, lead, follow) = (tokens(text), tokens(before), tokens(after));
+    let mut out = HashSet::from([
+        format!("len:{}", (words.len() / 20).min(8)),
+        format!("start:{}", shape(text.chars().next())),
+        format!("end:{}", shape(text.chars().next_back())),
+        format!("lead_end:{}", shape(before.chars().next_back())),
+        format!("follow_start:{}", shape(after.chars().next())),
+    ]);
+    if text.starts_with("...") || text.starts_with(". . .") {
+        out.insert("start:ellipsis".to_owned());
+    }
+    for n in 1..=3 {
+        if lead.len() >= n {
+            out.insert(format!("lead:{}", lead[lead.len() - n..].join(" ")));
+        }
+        if words.len() >= n {
+            out.insert(format!("head:{}", words[..n].join(" ")));
+            out.insert(format!("tail:{}", words[words.len() - n..].join(" ")));
+        }
+    }
+    if let Some(first) = follow.first() {
+        out.insert(format!("follow:{first}"));
+    }
+    out.extend(words.iter().map(|word| format!("w:{word}")));
+    if ALTERATION
+        .get_or_init(|| Regex::new(r"\[[A-Za-z][^\]]{0,25}\]").expect("alteration regex"))
+        .is_match(text)
+    {
+        out.insert("cue:bracketed_alteration".to_owned());
+    }
+    if NOTE
+        .get_or_init(|| {
+            Regex::new(r"(?i)(?:emphasis|italics|footnotes?|citations?) (?:added|omitted|in original)")
+                .expect("note regex")
+        })
+        .is_match(text)
+    {
+        out.insert("cue:alteration_note".to_owned());
+    }
+    if text.contains("...") || text.contains('\u{2026}') || text.contains(". . .") {
+        out.insert("cue:ellipsis".to_owned());
+    }
+    out
+}
+
+/// The passage's log-odds of being quoted, given the text before and after it.
+pub(super) fn quotation_score(text: &str, before: &str, after: &str) -> f64 {
+    let lexicon = lexicon();
+    let buckets = features(text, before, after)
+        .iter()
+        .map(|feature| fnv1a(feature) & ((1 << BITS) - 1))
+        .collect::<HashSet<_>>();
+    lexicon.bias
+        + buckets
+            .iter()
+            .filter_map(|bucket| lexicon.weights.get(bucket))
+            .sum::<f64>()
+}

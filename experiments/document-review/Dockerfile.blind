FROM node:22-bookworm-slim
ARG CODEX_VERSION=0.167.0
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip ripgrep file \
    && rm -rf /var/lib/apt/lists/* \
    && pip3 install --break-system-packages --no-cache-dir pypdf pillow \
    && npm install --global @openai/codex@${CODEX_VERSION}
WORKDIR /workspace
RUN mkdir -p /workspace/documents /workspace/output /root/.codex

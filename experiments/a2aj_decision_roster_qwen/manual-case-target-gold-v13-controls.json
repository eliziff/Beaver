      "issues": [
        {
          "question": "Did 083 have the right to terminate the contract on or before July 2, 2011?",
          "answers": [
            {
              "answer": "No. The contract required the deposit to be paid in trust to the named brokerage, and 388 complied with that obligation.",
              "positions": [
                {
                  "relation_to_disposition": "dispositive",
                  "answer_evidence": [
                    {
                      "start_line": 139,

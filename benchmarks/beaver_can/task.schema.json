{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^CAN-[A-Z]+-\\d{3}$"
    },
    "jurisdiction": {
      "type": "string",
      "pattern": "^CA(-[A-Z]{2})?$"
    },
    "law_as_of": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "task_type": {
      "type": "string",
      "enum": [
        "closed_source_research",
        "retrieval",
        "long_thread"
      ]
    },
    "deliverable": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "memorandum",
            "ranked_authorities"
          ]
        },
        "maximum_words": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "required_filename": {
          "type": "string",
          "pattern": "^[\\w.-]+$"
        }
      },
      "required": [
        "type",
        "required_filename"
      ],
      "additionalProperties": false
    },
    "source_ids": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^SRC-\\d{3}$"
      }
    },
    "fatal_errors": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "fabricated_authority",
          "fabricated_quotation",
          "invalid_pinpoint",
          "wrong_jurisdiction",
          "outside_source_packet",
          "superseded_instruction",
          "seeded_identifier_leak",
          "missing_artifact"
        ]
      }
    }
  },
  "required": [
    "id",
    "jurisdiction",
    "law_as_of",
    "task_type",
    "deliverable",
    "source_ids",
    "fatal_errors"
  ],
  "additionalProperties": false
}

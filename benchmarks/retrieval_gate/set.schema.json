{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "set_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "created": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "corpus": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "source",
        "revision"
      ],
      "additionalProperties": false
    },
    "items": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item_id": {
            "type": "string",
            "pattern": "^RG-\\d{3}$"
          },
          "query": {
            "type": "string",
            "minLength": 8
          },
          "corpus_ref": {
            "type": "object",
            "properties": {
              "jurisdiction": {
                "type": "string",
                "pattern": "^CA(-[A-Z]{2})?$"
              },
              "dataset": {
                "type": "string",
                "pattern": "^[A-Z0-9]+(?:-[A-Z0-9]+)*$"
              },
              "citation": {
                "type": "string",
                "minLength": 1
              },
              "citation_key": {
                "type": "string",
                "pattern": "^[a-z0-9]+$"
              }
            },
            "required": [
              "jurisdiction",
              "dataset",
              "citation",
              "citation_key"
            ],
            "additionalProperties": false
          },
          "gold_locators": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^sec\\d+[\\d.()a-z]*$"
            }
          },
          "gold_quote": {
            "type": "string",
            "minLength": 20,
            "maxLength": 600
          }
        },
        "required": [
          "item_id",
          "query",
          "corpus_ref",
          "gold_locators",
          "gold_quote"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "set_id",
    "created",
    "items"
  ],
  "additionalProperties": false
}

{
    "name": "mike",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "prebuild": "node scripts/guard-live-build.mjs",
        "build": "node scripts/build.mjs",
        "start": "next start",
        "lint": "eslint",
        "test": "vitest run && node --test scripts/guard-live-build.test.mjs",
        "preview": "npm run typecheck:opennext && opennextjs-cloudflare build && opennextjs-cloudflare preview",
        "deploy": "npm run typecheck:opennext && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
        "upload": "npm run typecheck:opennext && opennextjs-cloudflare build && opennextjs-cloudflare upload",
        "typecheck:opennext": "tsc --noEmit --strict --skipLibCheck --target ES2022 --module ESNext --moduleResolution Bundler --types node open-next.config.ts",
        "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
    },
    "dependencies": {
        "@fortune-sheet/core": "^1.0.4",
        "@fortune-sheet/react": "^1.0.4",
        "@supabase/supabase-js": "^2.81.1",
        "docx-preview": "^0.3.7",
        "dompurify": "^3.4.8",
        "exceljs": "^4.4.0",
        "lucide-react": "^0.553.0",
        "luckyexcel": "^1.0.1",
        "next": "^16.2.6",
        "pdfjs-dist": "4.10.38",
        "react": "19.2.0",
        "react-dom": "19.2.0",
        "react-markdown": "^10.1.0",
        "remark-gfm": "^4.0.1",
        "tailwind-merge": "^3.4.0"
    },
    "devDependencies": {
        "@opennextjs/cloudflare": "^1.19.9",
        "@tailwindcss/postcss": "^4",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@vitejs/plugin-react": "^4.7.0",
        "babel-plugin-react-compiler": "1.0.0",
        "docx": "^9.6.1",
        "eslint": "^9",
        "eslint-config-next": "^16.2.6",
        "jsdom": "^27.0.1",
        "tailwindcss": "^4",
        "typescript": "^5",
        "vitest": "^4.1.9",
        "wrangler": "^4.90.0"
    },
    "license": "AGPL-3.0-only"
}

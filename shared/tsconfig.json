{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "outDir": "runtime",
    "rootDir": "contracts",
    "resolveJsonModule": true,
    "types": [
      "node"
    ],
    "incremental": true,
    "tsBuildInfoFile": "../.tmp/shared.tsbuildinfo",
    "noEmitOnError": true
  },
  "include": [
    "contracts/*.mts"
  ]
}
